# Audio Configuration
# Buffer size for audio chunks in samples (lower = less latency, higher CPU usage)
# Typical values: 512-2048. Lower values reduce latency but increase CPU load
AUDIO_CHUNK=512

# Number of audio channels (1 = mono, 2 = stereo)
# Most audio sources use stereo (2 channels)
AUDIO_CHANNELS=2

# Sample rate in Hz (44100 = CD quality, 48000 = professional audio)
# Must match your audio source's sample rate for best results
AUDIO_RATE=44100

# Network Configuration
# Host address to bind the web server to
# 0.0.0.0 = accept connections from any network interface (public access)
# 127.0.0.1 = accept connections only from localhost (private access)
AUDIO_STREAMER_HOST=0.0.0.0

# Port number for the web server
# Ensure this port is not blocked by your firewall
AUDIO_STREAMER_PORT=4986

# Debug mode (true/false)
# Set to true for development to see detailed error messages
# Set to false in production for security and performance
AUDIO_STREAMER_DEBUG=False

# Streaming Configuration
# Maximum number of concurrent listeners/clients
# Higher values allow more connections but use more system resources
AUDIO_STREAMER_MAX_CLIENTS=10

# Available streaming bitrates in kbps (comma-separated)
# Valid range: 64-320 kbps
# Creates endpoints: /stream/128, /stream/192, /stream/320, etc.
# Lower bitrates use less bandwidth but lower audio quality
# Higher bitrates use more bandwidth but better audio quality
AUDIO_STREAM_BITRATES=128,192,320

# Queue size for each client (higher = more buffering, less dropouts, more memory)
# Each chunk is typically 1024-4096 bytes depending on AUDIO_CHUNK setting
AUDIO_STREAMER_QUEUE_SIZE=100

# FFmpeg output queue size for bitrate-based streaming
# This queue buffers encoded MP3 data between ffmpeg and the HTTP response
# Higher values = less audio drops during network slowdowns, but more memory usage
# Lower values = less memory usage, but may drop chunks if client is slow
# Recommended: 50-100 for typical use cases
FFMPEG_OUTPUT_QUEUE_SIZE=50

# FFmpeg queue timeout in seconds
# How long to wait for encoded data from ffmpeg before continuing to write more input
# Lower values = more responsive, but may increase CPU usage
# Higher values = less CPU usage, but may cause latency
# Recommended: 0.05-0.2 seconds
FFMPEG_QUEUE_TIMEOUT=0.1

# Streamer Configuration
# Name of your Streamer (displayed in the web interface and player)
RADIO_STATION_NAME=My Streamer

# Dashboard Authentication
# Username and password for accessing the admin dashboard
# Change these from the defaults for security in production
# The dashboard allows you to control streaming and view statistics
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=admin123
