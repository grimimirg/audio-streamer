# Audio Configuration
# Buffer size for audio chunks in samples (lower = less latency, higher CPU usage)
# Typical values: 512-2048. Lower values reduce latency but increase CPU load
AUDIO_CHUNK=512

# Number of audio channels (1 = mono, 2 = stereo)
# Most audio sources use stereo (2 channels)
AUDIO_CHANNELS=2

# Sample rate in Hz (44100 = CD quality, 48000 = professional audio)
# Must match your audio source's sample rate for best results
AUDIO_RATE=44100

# Network Configuration
# Host address to bind the web server to
# 0.0.0.0 = accept connections from any network interface (public access)
# 127.0.0.1 = accept connections only from localhost (private access)
AUDIO_STREAMER_HOST=0.0.0.0

# Port number for the web server
# Ensure this port is not blocked by your firewall
AUDIO_STREAMER_PORT=4986

# Debug mode (true/false)
# Set to true for development to see detailed error messages
# Set to false in production for security and performance
AUDIO_STREAMER_DEBUG=False

# Streaming Configuration
# Maximum number of concurrent listeners/clients
# Higher values allow more connections but use more system resources
AUDIO_STREAMER_MAX_CLIENTS=10

# Available streaming bitrates in kbps (comma-separated)
# Valid range: 64-320 kbps
# Creates endpoints: /stream/128, /stream/192, /stream/320, etc.
# Lower bitrates use less bandwidth but lower audio quality
# Higher bitrates use more bandwidth but better audio quality
AUDIO_STREAM_BITRATES=128,192,320

# Queue size for each client (higher = more buffering, less dropouts, more memory)
# Each chunk is typically 1024-4096 bytes depending on AUDIO_CHUNK setting
AUDIO_STREAMER_QUEUE_SIZE=100

# FFmpeg output queue size for bitrate-based streaming
# This queue buffers encoded MP3 data between ffmpeg and the HTTP response
# Higher values = less audio drops during network slowdowns, but more memory usage
# Lower values = less memory usage, but may drop chunks if client is slow
# Recommended: 50-100 for typical use cases
FFMPEG_OUTPUT_QUEUE_SIZE=50

# Number of threads ffmpeg may use per encoder process
# 0 = let ffmpeg decide based on available cores
# On a busy server with many active bitrates, setting this to 1 or 2 keeps a
# single encoder from monopolising every core
FFMPEG_THREADS=0

# FFmpeg queue timeout in seconds
# How long to wait for encoded data from ffmpeg before continuing to write more input
# Lower values = more responsive, but may increase CPU usage
# Higher values = less CPU usage, but may cause latency
# Recommended: 0.05-0.2 seconds
FFMPEG_QUEUE_TIMEOUT=0.1

# CPU Monitoring
# CPU usage percentage above which a warning is logged
# Measured across the application and its ffmpeg encoder processes
# Valid range: 1-100
CPU_WARNING_THRESHOLD=80

# How often CPU usage is sampled, in seconds
# Lower values react faster but sample more often
CPU_MONITOR_INTERVAL=5.0

# Streamer Configuration
# Name of your Streamer (displayed in the web interface and player)
RADIO_STATION_NAME=My Streamer

# Dashboard Authentication
# Username and password for accessing the admin dashboard
# Change these from the defaults for security in production
# The dashboard allows you to control streaming and view statistics
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=admin123

# Icecast Source Configuration
# Relay the live stream to an Icecast server, so listeners can also tune in
# through standard streaming infrastructure instead of only this application.
# Leave disabled to serve listeners from this application alone.
ICECAST_ENABLED=False

# Hostname or IP address of the Icecast server
ICECAST_HOST=localhost

# Port the Icecast server listens on (Icecast's own default is 8000)
ICECAST_PORT=8000

# Mount point to publish on, including the leading slash
# Listeners then tune in at http://ICECAST_HOST:ICECAST_PORT/stream
ICECAST_MOUNT=/stream

# Source credentials, as configured in your icecast.xml
# The user is almost always "source"; the password is <source-password>
ICECAST_USER=source
ICECAST_PASSWORD=

# Bitrate in kbps for the relayed stream
# Valid range: 64-320. Independent of AUDIO_STREAM_BITRATES, which only affects
# listeners connecting to this application directly
ICECAST_BITRATE=128

# Source protocol: http (Icecast 2), icy (Shoutcast-style), xaudiocast (legacy)
# Use http unless your server specifically requires one of the others
ICECAST_PROTOCOL=http

# Initial delay in seconds before retrying a dropped connection
# The delay doubles on each failed attempt, up to the maximum below
ICECAST_RECONNECT_DELAY=2.0

# Longest the relay will wait between reconnection attempts, in seconds
ICECAST_RECONNECT_MAX_DELAY=60.0

# Timeout in seconds for the startup reachability check
# Only used to report an unreachable server clearly at startup; it does not
# affect the stream itself
ICECAST_TEST_TIMEOUT=5.0

# Shoutcast Source Configuration
# Relay the live stream to a Shoutcast server, as an alternative or in addition
# to Icecast. Both relays can run at the same time, at the cost of one extra
# encoder process each.
#
# NOTE: this speaks the ICY source protocol, which is Shoutcast v1. The v2
# protocol (Ultravox) is not supported by libshout and is therefore unavailable.
# DNAS 2 servers accept v1 sources on their legacy source port.
SHOUTCAST_ENABLED=False

# Hostname or IP address of the Shoutcast server
SHOUTCAST_HOST=localhost

# Port the Shoutcast server accepts source connections on
# For DNAS 2 this is usually the legacy source port, not the listener port
SHOUTCAST_PORT=8000

# Mount point to publish on, including the leading slash
SHOUTCAST_MOUNT=/stream

# Source credentials
# Shoutcast traditionally authenticates with the password alone; leave the user
# as "source" unless your server requires otherwise
SHOUTCAST_USER=source
SHOUTCAST_PASSWORD=

# Bitrate in kbps for the relayed stream
# Valid range: 64-320
SHOUTCAST_BITRATE=128

# Initial delay in seconds before retrying a dropped connection
# The delay doubles on each failed attempt, up to the maximum below
SHOUTCAST_RECONNECT_DELAY=2.0

# Longest the relay will wait between reconnection attempts, in seconds
SHOUTCAST_RECONNECT_MAX_DELAY=60.0

# Timeout in seconds for the startup reachability check
SHOUTCAST_TEST_TIMEOUT=5.0
