# Audio Configuration
# Buffer size for audio chunks (lower = less latency, higher CPU usage)
AUDIO_CHUNK=512

# Number of audio channels (1 = mono, 2 = stereo)
AUDIO_CHANNELS=2

# Sample rate in Hz (44100 = CD quality, 48000 = professional)
AUDIO_RATE=44100

# Network Configuration
# Host address (0.0.0.0 = accept connections from anywhere, 127.0.0.1 = localhost only)
AUDIO_STREAMER_HOST=0.0.0.0

# Port number for the web server
AUDIO_STREAMER_PORT=4986

# Debug mode (true/false) - set to false in production
AUDIO_STREAMER_DEBUG=False

# Streaming Configuration
# Maximum number of concurrent listeners
AUDIO_STREAMER_MAX_CLIENTS=10

# Queue size for each client (higher = more buffering, less dropouts)
AUDIO_STREAMER_QUEUE_SIZE=100

# Radio Station Configuration
# Name of your radio station (displayed in the web interface)
RADIO_STATION_NAME=My Radio Station
